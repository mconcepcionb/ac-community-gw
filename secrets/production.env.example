# Plaintext template for the encrypted production secret set
# (secrets/production.sops.env). Names only: never put real values here.
#
# The operator creates the encrypted set on first deploy:
#   task secrets:encrypt ENV=production FROM=<flat-env-file>
# and materializes it on the deploy host (see docs/runbooks/deploy.md and
# docs/runbooks/secret-management.md).

# --- Runtime -----------------------------------------------------------------
ACGW_ENV=production
ACGW_HTTP_ADDR=:8080

# --- PostgreSQL (gateway-owned database) -------------------------------------
ACGW_DATABASE_URL=
ACGW_DB_AUTO_MIGRATE=false

# --- Discord OAuth2 ----------------------------------------------------------
ACGW_DISCORD_CLIENT_ID=
ACGW_DISCORD_CLIENT_SECRET=
ACGW_DISCORD_REDIRECT_URL=
ACGW_DISCORD_GUILD_ID=
ACGW_DISCORD_POST_LOGIN_REDIRECT_URL=

# --- AzerothCore SOAP (private network, never public) ------------------------
ACGW_AZEROTH_SOAP_URL=
ACGW_AZEROTH_SOAP_USERNAME=
ACGW_AZEROTH_SOAP_PASSWORD=
ACGW_AZEROTH_LOGIN_DB_DSN=
ACGW_AZEROTH_CHARACTER_DB_DSN=
ACGW_AZEROTH_WORLD_DB_DSN=

# --- Sessions and proxies (production requires secure cookies) ---------------
ACGW_SESSION_COOKIE_SECURE=true
ACGW_TRUSTED_PROXIES=

# --- Metrics (required in production when enabled) ---------------------------
ACGW_METRICS_TOKEN=
