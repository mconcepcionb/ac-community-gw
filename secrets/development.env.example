# Plaintext template for the encrypted development secret set
# (secrets/development.sops.env). Names only: never put real values here.
#
# Edit the encrypted file with `task secrets:edit ENV=development`; bring it to
# a machine with `task secrets:decrypt ENV=development`. See
# docs/runbooks/secret-management.md.

# --- PostgreSQL (gateway-owned database) -------------------------------------
ACGW_DATABASE_URL=
POSTGRES_PASSWORD=

# --- AzerothCore development databases (compose) -----------------------------
MARIADB_ROOT_PASSWORD=
MARIADB_PASSWORD=

# --- Discord OAuth2 ----------------------------------------------------------
ACGW_DISCORD_CLIENT_ID=
ACGW_DISCORD_CLIENT_SECRET=
ACGW_DISCORD_REDIRECT_URL=
ACGW_DISCORD_GUILD_ID=
ACGW_DISCORD_POST_LOGIN_REDIRECT_URL=

# --- AzerothCore SOAP (private network, never public) ------------------------
ACGW_AZEROTH_SOAP_URL=
ACGW_AZEROTH_SOAP_USERNAME=
ACGW_AZEROTH_SOAP_PASSWORD=

# --- Optional ----------------------------------------------------------------
# ACGW_METRICS_TOKEN=
# CLOUDFLARE_TUNNEL_TOKEN=
