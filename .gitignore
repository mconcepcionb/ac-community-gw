# Binaries
/bin/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test and coverage output
*.out
coverage.txt
coverage-integration.txt
coverage.html

# Go workspace files
go.work
go.work.sum

# Environment and secrets
.env
.env.*
!.env.example

# Encrypted secret sets (SOPS + age). Only the encrypted file and the plaintext
# template are tracked; decrypted output stays out of git.
secrets/**
!secrets/*.env.example
!secrets/*.sops.env

# IDE / editor
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Temporary
/tmp/
*.log

# Demo runtime output
.demo/

# Frontend (web/)
web/node_modules/
web/dist/
web/coverage/
web/.vite/
web/.tanstack/
